DJANGO_DEBUG=false/true
DJANGO_SECRET_KEY=<your-secret-key>

DJANGO_ALLOWED_HOSTS=<your-allowed-hosts>  # e.g., localhost,
DJANGO_CORS_ALLOWED_ORIGINS=<your-allowed-origins>  # e.g., http://localhost:5173,http://
DJANGO_CORS_ALLOW_CREDENTIALS=true
DJANGO_CSRF_TRUSTED_ORIGINS=<your-trusted-origins>  # e.g., http://localhost:5173,http://

# RDS settings (fill in your real values)
POSTGRES_DB=<your db name>
POSTGRES_USER=<your db user>
POSTGRES_PASSWORD=<your db password>
POSTGRES_HOST=<your db host>
POSTGRES_PORT=<your db port> # e.g., 5432